<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#14001f">
    <meta name="description" content="<%= htmlWebpackPlugin.options.description %>">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <link rel="apple-touch-icon" href="<%= htmlWebpackPlugin.options.root %>images/apple-touch-icon.png">
    <% if (htmlWebpackPlugin.options.forwardOldLinks) { %>
    <script>
      // Old links to a project on the home page (/#123456, /?project_url=...) now open the game page.
      (function () {
        if (/^#\d+/.test(location.hash) || /[?&]project_url=/.test(location.search)) {
          location.replace('<%= htmlWebpackPlugin.options.root %>game' + location.search + location.hash);
        }
      })();
    </script>
    <% } %>
    <link rel="preload" href="<%= htmlWebpackPlugin.options.root %>fonts/press-start-2p-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<%= htmlWebpackPlugin.options.root %>fonts/space-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="<%= htmlWebpackPlugin.options.root %>fonts/fonts.css">
    <style>
      html, body {
        margin: 0;
        background: #14001f;
      }
    </style>
  </head>
  <body>
    <noscript>
      <p style="color:#fff;font-family:sans-serif;padding:20px">Sparkjam needs JavaScript to run.</p>
    </noscript>
    <div id="app"></div>
  </body>
</html>
